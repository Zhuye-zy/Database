			<exch:invention-title lang="de" data-format="docdba">Vergasungsbrenner.</exch:invention-title>
			<exch:invention-title lang="en" data-format="docdba">Gasification burner.</exch:invention-title>
			<exch:invention-title lang="fr" data-format="docdba">Brûleur à gazéification.</exch:invention-title>
